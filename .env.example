# Copy to .env and fill in. Never commit .env.
CRA_ENVIRONMENT=dev
CRA_LOG_LEVEL=INFO
CRA_TRACE_DIR=traces

# Agent budgets (hard limits, see docs/design: section 5.2)
CRA_MAX_STEPS=12
CRA_MAX_TOKENS_PER_CASE=60000
CRA_CASE_TIMEOUT_SECONDS=120
CRA_COST_CAP_USD=1.0

# LLM provider (needed from Phase 3 onward)
CRA_ANTHROPIC_API_KEY=

# Database. Supabase: Dashboard > Connect > Session pooler string (port 5432).
# Local Docker alternative: postgresql://cra:cra_dev_only@localhost:5432/cra
CRA_DATABASE_URL=